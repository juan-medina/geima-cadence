{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Godot: Debug Project",
			"type": "godot",
			"request": "launch",
			"project": "${workspaceFolder}/src",
			"scene": "main"
		},
		{
			"name": "Godot: Debug Project (diagnosis)",
			"type": "godot",
